# ─── Spotify OAuth 2.0 ────────────────────────────────────────────────────────
# Get these from https://developer.spotify.com/dashboard
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Redirect URI registered in your Spotify app dashboard
# For development: exp://127.0.0.1:8081
# For production:  soundnote://auth/callback
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=exp://127.0.0.1:8081

# ─── Notes ────────────────────────────────────────────────────────────────────
# NEVER add SPOTIFY_CLIENT_SECRET here — we use PKCE (no secret needed).
# Variables prefixed with EXPO_PUBLIC_ are safe to read on the client.
# Copy this file to .env and fill in real values. NEVER commit .env to Git.

